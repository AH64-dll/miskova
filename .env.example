# ==============================================================================
# Miskova E-Commerce Environment Configuration
# Copy this file to .env.local and set your values:
#   cp .env.example .env.local
# ==============================================================================

# Required: The password used to log in to the /admin orders dashboard
ADMIN_PASSWORD=change-this-to-a-strong-password

# Optional: Custom storage paths for orders and reviews (defaults to .data/*.json)
# If deploying to a container with a persistent volume mounted at /data:
# ORDERS_STORE_PATH=/data/orders.json
# REVIEWS_STORE_PATH=/data/reviews.json

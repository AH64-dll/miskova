!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build + runtime artifacts
.next/
out/
node_modules/
.data/
*.log
clientW=${res.clientW}
tsconfig.tsbuildinfo
tsconfig.scenecheck.tsbuildinfo

# reference snapshots + design plan bundle (large, not source)
reference/
Miskova-Website-Redesign-Plan/
Miskova-Website-Redesign-Plan.zip
homepage.html
page.html
assets/platform/
*.log

# one-off local probe scripts
*.py
